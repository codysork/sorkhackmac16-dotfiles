
#!/bin/bash
#
# @file repeat (todo.sh action)
# @author Mark D. White (edited by Cody Sork <codysork@gmail.com> with help from ChatGPT)
# @created 2011-11-16
# @modified 2026-11-05
# @description An addon command for todo.txt-cli that marks an item done and 
#              immediately re-enters it.

action=$1
shift

function usage {
    echo " Customized repeat:"
    echo "   repeat ITEM"
    echo "     mark an item complete then re-enter it"
    echo "   repeat ITEM DAYS"
    echo "     mark an item complete then re-enter it with a date DAYS from now"
    echo "   repeat ITEM +DAYS"
    echo "     mark an item with a date complete then re-enter it with a date DAYS from the due date"
    echo ""
    exit
}

[ "$action" = "usage" ] && usage

# Make sure we have an item number
ITEM=$1

if ! [[ "$ITEM" =~ ^[0-9]+$ ]]; then
    echo "Error! Usage:"
    usage
fi

# Pull the line from the todo file
LINE=$(sed "$ITEM!d" "$TODO_FILE")

# Preserve priority
PRIORITY=""

if [[ "$LINE" == \([A-Z]\)\ * ]]; then
    PRIORITY=${LINE:1:1}
    LINE=${LINE:4}
fi

# Identify and remove the date
if [[ "$LINE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\  ]]; then
    DATE=${LINE%% *}
    LINE=${LINE#* }
else
    DATE=""
fi

# Process optional DAYS argument
DAYS=$2

if [[ "$DAYS" != "" ]]; then
    if [[ "$DAYS" == +* ]]; then
        if [[ "$DATE" != "" ]]; then
            # Increase the due date
            DATE=$(date -d "$DATE $DAYS days" +%Y-%m-%d)
        fi
    elif [[ "$DAYS" =~ ^[0-9]+$ ]]; then
        # Make new date relative from now
        DATE=$(date -d "$DAYS days" +%Y-%m-%d)
    fi

    if [[ "$DATE" != "" ]]; then
        LINE="$DATE $LINE"
    fi
fi

# Restore priority
if [[ "$PRIORITY" != "" ]]; then
    LINE="($PRIORITY) $LINE"
fi

# Complete original task and add repeated task
if [[ "$LINE" != "" ]]; then
    $DO && "$TODO_SH" command do "$ITEM"
    $DO && "$TODO_SH" command add "$LINE"
fi

