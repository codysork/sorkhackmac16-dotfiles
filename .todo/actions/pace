
#!/usr/bin/env bash
#
# @file pace (todo.sh action)
# @author Cody Sork <codysork@gmail.com> with help from ChatGPT
# @created 2026-11-04
# @modified 2026-11-04
# @description Calculate story-point velocity.
#
# Usage:
#   todo.sh pace [daily|weekly|monthly|annual] [count]

set -euo pipefail

#----------------------------------------------------------------------------
# Configuration
#----------------------------------------------------------------------------

DONE_FILE="${DONE_FILE:-${TODO_DIR:-$HOME}/done.txt}"
TODAY=$(date +%Y-%m-%d)

#----------------------------------------------------------------------------
# Functions
#----------------------------------------------------------------------------

usage() {
    echo "Usage: todo.sh pace [daily|weekly|monthly|annual] [count]"
}

# Sum story points completed within a date range.
sum_points() {
    local start="$1"
    local end="$2"

    awk -v start="$start" -v end="$end" '
        $1 == "x" && $2 >= start && $2 <= end {
            for (i = 3; i <= NF; i++) {
                if ($i ~ /^sp:[0-9]+([.][0-9]+)?$/) {
                    sum += substr($i, 4)
                    break
                }
            }
        }
        END {
            printf "%.2f", sum
        }
    ' "$DONE_FILE"
}

# Calculate inclusive calendar days between two dates.
days_between() {
    local start="$1"
    local end="$2"

    echo $(( (
        $(date -d "$end" +%s) -
        $(date -d "$start" +%s)
    ) / 86400 + 1 ))
}

# Print report header.
print_header() {
    echo
    printf '%-16s %10s %8s %12s\n' \
        "Period" "Points" "Days" "SP/day"
    printf '%-16s %10s %8s %12s\n' \
        "----------------" "----------" "--------" "------------"
}

# Generate a report row.
report_period() {
    local label="$1"
    local start="$2"
    local end="$3"

    local days
    local points
    local velocity

    days=$(days_between "$start" "$end")
    points=$(sum_points "$start" "$end")

    velocity=$(awk -v points="$points" -v days="$days" \
        'BEGIN { printf "%.2f", points / days }')

    printf '%-16s %10s %8s %12s\n' \
        "$label" "$points" "$days" "$velocity"
}

#----------------------------------------------------------------------------
# Main
#----------------------------------------------------------------------------

# Validate arguments.
MODE="${2:-monthly}"
COUNT="${3:-}"

case "$MODE" in
    daily|weekly|monthly|annual|yearly)
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        echo "Error: Invalid pace mode '$MODE'." >&2
        usage >&2
        exit 1
        ;;
esac

# Set default period count.
if [[ -z "$COUNT" ]]; then
    case "$MODE" in
        daily)          COUNT=30 ;;
        weekly)         COUNT=52 ;;
        monthly)        COUNT=12 ;;
        annual|yearly)  COUNT=10 ;;
    esac
fi

# Validate period count.
if [[ ! "$COUNT" =~ ^[0-9]+$ ]] || (( 10#$COUNT == 0 )); then
    echo "Error: Count must be a positive integer." >&2
    usage >&2
    exit 1
fi

COUNT=$((10#$COUNT))

# Dependencies.
for cmd in date awk; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "Error: Required command '$cmd' not found." >&2
        exit 1
    }
done

# Validate done.txt.
if [[ ! -f "$DONE_FILE" || ! -r "$DONE_FILE" ]]; then
    echo "Error: Cannot read done file: $DONE_FILE" >&2
    exit 1
fi

# Print report header.
print_header

case "$MODE" in

    # Daily: Last N days.
    daily)
        for ((i = COUNT - 1; i >= 0; i--)); do
            START=$(date -d "$TODAY - $i days" +%Y-%m-%d)
            LABEL=$(date -d "$START" '+%Y-%m-%d')

            report_period "$LABEL" "$START" "$START"
        done
        ;;

    # Weekly: Last N weeks.
    weekly)
        DOW=$(date -d "$TODAY" +%u)
        CURRENT_WEEK=$(date -d "$TODAY - $((DOW - 1)) days" +%Y-%m-%d)

        for ((i = COUNT - 1; i >= 0; i--)); do
            START=$(date -d "$CURRENT_WEEK - $i weeks" +%Y-%m-%d)
            END=$(date -d "$START + 6 days" +%Y-%m-%d)

            # Do not include future days in the current week.
            if [[ "$END" > "$TODAY" ]]; then
                END="$TODAY"
            fi

            LABEL=$(date -d "$START" '+%G-W%V')

            report_period "$LABEL" "$START" "$END"
        done
        ;;

    # Monthly: Last N months.
    monthly)
        CURRENT_MONTH=$(date -d "$TODAY" +%Y-%m-01)

        for ((i = COUNT - 1; i >= 0; i--)); do
            START=$(date -d "$CURRENT_MONTH - $i months" +%Y-%m-%d)
            NEXT_MONTH=$(date -d "$START + 1 month" +%Y-%m-%d)
            END=$(date -d "$NEXT_MONTH - 1 day" +%Y-%m-%d)

            if [[ "$END" > "$TODAY" ]]; then
                END="$TODAY"
            fi

            LABEL=$(date -d "$START" '+%b %Y')

            report_period "$LABEL" "$START" "$END"
        done
        ;;

    # Annual: Last N years.
    annual|yearly)
        CURRENT_YEAR=$(date -d "$TODAY" +%Y-01-01)

        for ((i = COUNT - 1; i >= 0; i--)); do
            START=$(date -d "$CURRENT_YEAR - $i years" +%Y-%m-%d)
            NEXT_YEAR=$(date -d "$START + 1 year" +%Y-%m-%d)
            END=$(date -d "$NEXT_YEAR - 1 day" +%Y-%m-%d)

            if [[ "$END" > "$TODAY" ]]; then
                END="$TODAY"
            fi

            LABEL=$(date -d "$START" '+%Y')

            report_period "$LABEL" "$START" "$END"
        done
        ;;

esac

echo

