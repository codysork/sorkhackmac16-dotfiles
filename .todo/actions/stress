#!/bin/bash
#
# @file stress
# @author Cody Sork <codysork@gmail.com> with help from ChatGPT
# @created 2026-11-04
# @modified 2026-11-04
# @description Report daily hassle, uplift, and stress scores.

set -euo pipefail

# ----------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------

DONE_FILE="${DONE_FILE:-${TODO_DIR:-$HOME}/done.txt}"
TODAY=$(date +%F)

# ----------------------------------------------------------------------
# Functions
# ----------------------------------------------------------------------

usage() {
    cat <<EOF
Usage: todo.sh stress [daily|weekly|monthly|annual] [count]

Reporting periods:
    daily       Last 30 days (default)
    weekly      Last 52 weeks
    monthly     Last 12 months
    annual      Last 10 years

Examples:
    todo.sh stress
    todo.sh stress daily 7
    todo.sh stress weekly 12
    todo.sh stress monthly 6
    todo.sh stress annual 3
EOF
}

# Calculate hassle, uplift, and stress totals for a date range.
#
# Only completed tasks are considered.
# The first valid hassle:n and uplift:n tags are used independently.

sum_stress() {
    local start="$1"
    local end="$2"

    awk -v start="$start" -v end="$end" '
        BEGIN {
            total_hassle = 0
            total_uplift = 0
        }

        $1 == "x" && $2 >= start && $2 <= end &&
        $2 ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/ {
            hassle = 0
            uplift = 0

            found_hassle = 0
            found_uplift = 0

            for (i = 3; i <= NF; i++) {
                if (!found_hassle && $i ~ /^hassle:[0-9]+([.][0-9]+)?$/) {
                    value = $i
                    sub(/^hassle:/, "", value)

                    hassle = value
                    found_hassle = 1
                }

                if (!found_uplift && $i ~ /^uplift:[0-9]+([.][0-9]+)?$/) {
                    value = $i
                    sub(/^uplift:/, "", value)

                    uplift = value
                    found_uplift = 1
                }
            }

            total_hassle += hassle
            total_uplift += uplift
        }

        END {
            stress = total_hassle - total_uplift

            printf "%.2f\t%.2f\t%.2f\n",
                total_hassle, total_uplift, stress
        }
    ' "$DONE_FILE"
}

# Calculate the number of calendar days between two dates.
days_between() {
    local start="$1"
    local end="$2"

    local start_epoch
    local end_epoch

    start_epoch=$(date -u -d "$start" +%s)
    end_epoch=$(date -u -d "$end" +%s)

    echo $(( (end_epoch - start_epoch) / 86400 ))
}

# Print the report header.
print_header() {
    echo
    printf "%-23s %10s %10s %10s %8s %10s\n" \
        "Period" "Hassle" "Uplift" "Stress" "Days" "Stress/day"

    printf '%-23s %10s %10s %10s %8s %10s\n' \
        "-----------------------" \
        "----------" \
        "----------" \
        "----------" \
        "--------" \
        "----------"
}

# Report a single period.
report_period() {
    local label="$1"
    local start="$2"
    local end="$3"

    local days
    local hassle
    local uplift
    local stress
    local stress_per_day
    local totals

    days=$(( $(days_between "$start" "$end") + 1 ))

    totals=$(sum_stress "$start" "$end")

    IFS=$'\t' read -r hassle uplift stress <<< "$totals"

    stress_per_day=$(
        awk -v stress="$stress" -v days="$days" \
            'BEGIN { printf "%.2f", stress / days }'
    )

    printf "%-21s %10.2f %10.2f %10.2f %8d %10s\n" \
        "$label" \
        "$hassle" \
        "$uplift" \
        "$stress" \
        "$days" \
        "$stress_per_day"
}

# ----------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------

MODE="${2:-monthly}"
COUNT="${3:-}"

# Validate reporting mode.
case "$MODE" in
    day|daily|week|weekly|month|monthly|annual|year|yearly)
        ;;
    *)
        usage
        exit 1
        ;;
esac

# Set default reporting count.
if [[ -z "$COUNT" ]]; then
    case "$MODE" in
        day|daily)   COUNT=30 ;;
        week|weekly)  COUNT=52 ;;
        month|monthly) COUNT=12 ;;
        annual|year|yearly) COUNT=10 ;;
    esac
fi

# Validate count.
if [[ ! "$COUNT" =~ ^[1-9][0-9]*$ ]]; then
    echo "Error: Count must be a positive integer." >&2
    usage
    exit 1
fi

# Check done.txt.
if [[ ! -f "$DONE_FILE" ]]; then
    echo "Error: Done file not found: $DONE_FILE" >&2
    exit 1
fi

# Use a consistent decimal separator.
export LC_ALL=C

print_header

case "$MODE" in

    # --------------------------------------------------------------
    # Daily
    # --------------------------------------------------------------

    day|daily)
        for ((i = COUNT - 1; i >= 0; i--)); do
            DATE=$(date -d "$TODAY - $i days" +%F)

            report_period "$DATE" "$DATE" "$DATE"
        done
        ;;

    # --------------------------------------------------------------
    # Weekly (Monday-Sunday)
    # --------------------------------------------------------------

    week|weekly)
        DOW=$(date -d "$TODAY" +%u)
        CURRENT_WEEK=$(date -d "$TODAY - $((DOW - 1)) days" +%F)

        for ((i = COUNT - 1; i >= 0; i--)); do
            START=$(date -d "$CURRENT_WEEK - $((i * 7)) days" +%F)
            END=$(date -d "$START + 6 days" +%F)

            # Do not include future days in the current week.
            if [[ "$END" > "$TODAY" ]]; then
                END="$TODAY"
            fi

            LABEL="$START - $END"

            report_period "$LABEL" "$START" "$END"
        done
        ;;

    # --------------------------------------------------------------
    # Monthly
    # --------------------------------------------------------------

    month|monthly)
        CURRENT_MONTH=$(date -d "$TODAY" +%Y-%m-01)

        for ((i = COUNT - 1; i >= 0; i--)); do
            START=$(date -d "$CURRENT_MONTH - $i months" +%F)
            END=$(date -d "$START + 1 month - 1 day" +%F)

            # Do not include future days in the current month.
            if [[ "$END" > "$TODAY" ]]; then
                END="$TODAY"
            fi

            LABEL=$(date -d "$START" +%Y-%m)

            report_period "$LABEL" "$START" "$END"
        done
        ;;

    # --------------------------------------------------------------
    # Annual
    # --------------------------------------------------------------

    annual|year|yearly)
        CURRENT_YEAR=$(date -d "$TODAY" +%Y-01-01)

        for ((i = COUNT - 1; i >= 0; i--)); do
            START=$(date -d "$CURRENT_YEAR - $i years" +%F)
            END=$(date -d "$START + 1 year - 1 day" +%F)

            # Do not include future days in the current year.
            if [[ "$END" > "$TODAY" ]]; then
                END="$TODAY"
            fi

            LABEL=$(date -d "$START" +%Y)

            report_period "$LABEL" "$START" "$END"
        done
        ;;

esac
